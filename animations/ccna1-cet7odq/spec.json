{
 "key": "16.2.4-2",
 "duration": 20.0,
 "title": "DDoS: злоумышленник активирует ботнет — зомби-ПК заваливают веб-сервер конвертами",
 "storyboard": [
  [
   "0,0–0,5",
   "статичная сцена: три ПК сверху, облако Интернет, веб-сервер слева внизу, ПК злоумышленника справа внизу"
  ],
  [
   "0,5–1,1",
   "справа от облака над злоумышленником проявляется его реплика «Я инфицировал компьютеры…»; 1,2–1,6 к ней прорисовывается хвостик к его ПК"
  ],
  [
   "3,6",
   "слева от ПК злоумышленника (на линии к облаку) появляется конверт"
  ],
  [
   "5,1–7,9",
   "ровный поток конвертов (каждые ~0,2 с) уезжает от злоумышленника по линии и скрывается под облаком; последним уезжает стоящий конверт (7,7)"
  ],
  [
   "5,5–8,4",
   "из-за облака выходят парами конверты к левому ПК (первый прибывает 5,8, рейс ~0,3 с) и к правому (первый 6,5, рейс ~0,5 с), встают вплотную к ПК; следующие вливаются в стоящий"
  ],
  [
   "8,8–9,5",
   "конверты у левого и правого ПК плавно гаснут; 9,1–9,4 на их экранах появляется конверт (код заражения получен)"
  ],
  [
   "9,6–10,3",
   "реплика злоумышленника гаснет; над левым и правым ПК проявляются реплики «Активируется код DDoS-атаки.» (хвостики 10,1–10,4)"
  ],
  [
   "11,1–11,9",
   "рядом с левым и правым ПК снова проявляются конверты; 11,3–11,6 экраны возвращаются к обычным"
  ],
  [
   "12,2–15,6",
   "потоки конвертов от обоих ПК уходят в облако (от левого медленно, ~0,45 с, от правого ~0,3 с), из облака выходят к веб-серверу (первый прибывает 13,0) и встают у него; стоящие конверты у ПК уезжают последними: левый 14,1, правый 14,8"
  ],
  [
   "13,3–14,0",
   "над сервером проявляется реплика «Слишком много трафика.» (хвостик 14,3–14,7)"
  ],
  [
   "14,4–14,8",
   "на передней панели сервера появляется конверт (сервер завален трафиком)"
  ],
  [
   "14,5–15,1",
   "реплики над ПК гаснут"
  ],
  [
   "15,9–16,6",
   "конверт у сервера плавно гаснет"
  ],
  [
   "17,3–18,0",
   "реплика сервера гаснет"
  ],
  [
   "19,3–20,0",
