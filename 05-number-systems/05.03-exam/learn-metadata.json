                {
                    "answerId": "q02-a3",
                    "answer": "234.17.10.9",
                    "correct": false,
                    "comment": "Неверны три октета: 11101100 = 236, 00001100 = 8 + 4 = 12, 00001010 = 8 + 2 = 10. Адрес — 236.17.12.10."
                },
                {
                    "answerId": "q02-a4",
                    "answer": "236.17.12.10",
                    "correct": true
                }
            ]
