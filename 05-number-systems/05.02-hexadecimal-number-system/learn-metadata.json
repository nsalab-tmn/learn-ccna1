            "questionId": "q01",
            "bloom": "apply",
            "question": "Какой шестнадцатеричный эквивалент для десятичного 202?",
            "answerType": "singleChoice",
            "answers": [
                {
                    "answerId": "q01-a1",
                    "answer": "B10",
                    "correct": false,
                    "comment": "Значение 10 записывается одной шестнадцатеричной цифрой A, а не «10», а старшая четверка 1100 — это C (12), а не B (11). 202 = 11001010: 1100 = C, 1010 = A, то есть CA."
                },
                {
                    "answerId": "q01-a2",
                    "answer": "BA",
                    "correct": false,
                    "comment": "BA = 10111010 — это 186. В числе 202 = 11001010 старшая четверка 1100 — это C (12), а не B (11), поэтому ответ CA."
                },
                {
                    "answerId": "q01-a3",
                    "answer": "C10",
                    "correct": false,
                    "comment": "Значение 10 записывается одной шестнадцатеричной цифрой A, а не двумя цифрами «10». 202 = 11001010: 1100 = C, 1010 = A, то есть CA."
                },
                {
                    "answerId": "q01-a4",
                    "answer": "CA",
                    "correct": true
                }
            ]
        },
        {
            "questionId": "q02",
            "bloom": "apply",
            "question": "Какой шестнадцатеричный эквивалент для десятичного 254?",
            "answerType": "singleChoice",
            "answers": [
                {
                    "answerId": "q02-a1",
                    "answer": "EA",
                    "correct": false,
                    "comment": "EA = 11101010 — это 234. 254 = 11111110: старшая четверка 1111 — F, младшая 1110 — E, то есть FE."
                },
                {
                    "answerId": "q02-a2",
                    "answer": "ED",
                    "correct": false,
                    "comment": "ED = 11101101 — это 237. 254 = 11111110: старшая четверка 1111 — F, младшая 1110 — E, то есть FE."
                },
                {
                    "answerId": "q02-a3",
                    "answer": "FA",
                    "correct": false,
                    "comment": "FA = 11111010 — это 250: младшая четверка 1010 — A (10), а в числе 254 она равна 1110 — E (14). 254 = FE."
                },
                {
                    "answerId": "q02-a4",
                    "answer": "FE",
                    "correct": true
                }
            ]
        },
        {
