    "questions": [
        {
            "questionId": "q01",
            "bloom": "remember",
            "question": "Какой двоичный эквивалент IP-адреса 192.168.11.10?",
            "answerType": "singleChoice",
            "answers": [
                {
                    "answerId": "q01-a1",
                    "answer": "11000000.11000000.00001011.00001010",
                    "correct": false,
                    "comment": "Второй октет 11000000 — это 192 (128 + 64), а не 168. 168 = 128 + 32 + 8, то есть 10101000."
                },
                {
                    "answerId": "q01-a2",
                    "answer": "11000000.10101000.00001011.00001010",
                    "correct": true
                },
                {
                    "answerId": "q01-a3",
                    "answer": "11000000.10101000.00001010.00001011",
                    "correct": false,
                    "comment": "Третий и четвертый октеты переставлены: 00001010 — это 10, а 00001011 — 11. Третий октет адреса — 11 (00001011), четвертый — 10 (00001010)."
                },
                {
                    "answerId": "q01-a4",
                    "answer": "11000000.10101000.00001011.00010010",
                    "correct": false,
                    "comment": "Четвертый октет 00010010 — это 18 (16 + 2), а не 10. 10 = 8 + 2, то есть 00001010."
                }
            ]
        },
        {
            "questionId": "q02",
            "bloom": "apply",
            "question": "Какая двоичная запись соответствует IPv4-адресу 172.16.31.30?",
            "answerType": "singleChoice",
            "answers": [
                {
                    "answerId": "q02-a1",
                    "answer": "11000000.00010000.00011111.00011110",
                    "correct": false,
                    "comment": "Первый октет 11000000 — это 192 (128 + 64), а не 172. 172 = 128 + 32 + 8 + 4, то есть 10101100."
                },
                {
                    "answerId": "q02-a2",
                    "answer": "10101000.00010000.00011111.00011110",
                    "correct": false,
                    "comment": "Первый октет 10101000 — это 168 (128 + 32 + 8): не учтен разряд 4. 172 = 128 + 32 + 8 + 4, то есть 10101100."
                },
                {
                    "answerId": "q02-a4",
                    "answer": "10101100.00010000.00011111.00011110",
                    "correct": true
                },
                {
                    "answerId": "q02-a5",
                    "answer": "10101100.00010000.00011110.00011111",
                    "correct": false,
                    "comment": "Третий и четвертый октеты переставлены: 00011110 — это 30, а 00011111 — 31. Третий октет адреса — 31 (00011111), четвертый — 30 (00011110)."
                }
            ]
        },
        {
            "questionId": "q03",
            "bloom": "apply",
            "question": "Компьютер хранит свой IPv4-адрес как сплошной 32-битный поток: 11000110001100110110010000101101. Как этот адрес записывается в десятичном формате с точкой-разделителем?",
            "answerType": "singleChoice",
            "answers": [
                {
                    "answerId": "q03-a1",
                    "answer": "198.51.100.45",
                    "correct": true
                },
                {
                    "answerId": "q03-a2",
                    "answer": "45.100.51.198",
                    "correct": false,
                    "comment": "Октеты записаны в обратном порядке. Поток делят на четыре октета по 8 бит слева направо: 11000110 = 198 — первый октет, 00101101 = 45 — четвертый."
                },
                {
                    "answerId": "q03-a3",
                    "answer": "99.204.38.180",
                    "correct": false,
                    "comment": "Биты каждого октета прочитаны справа налево. Старший разряд (128) — крайний левый бит октета: 11000110 = 128 + 64 + 4 + 2 = 198, а не 99."
                },
                {
                    "answerId": "q03-a4",
                    "answer": "198.51.36.45",
                    "correct": false,
                    "comment": "В третьем октете 01100100 не учтен разряд 64: 64 + 32 + 4 = 100, а не 36. Адрес — 198.51.100.45."
                }
            ]
        }
    ]
